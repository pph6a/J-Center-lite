<Page
    x:Class="JCenterLite.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />

            <Border Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="设备连接" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Header="adb.exe 路径" PlaceholderText="{x:Bind ViewModel.DetectedAdb}" Text="{x:Bind ViewModel.AdbPath, Mode=TwoWay}" />
                        <Button Grid.Column="1" Click="BrowseAdb_Click" Content="浏览" />
                    </Grid>
                    <TextBox Header="ffmpeg.exe 路径（可选，用于 GIF / 视频转换）" Text="{x:Bind ViewModel.FfmpegPath, Mode=TwoWay}" />
                    <NumberBox Header="本地转发端口" Maximum="65535" Minimum="1024" Value="{x:Bind ViewModel.ForwardPort, Mode=TwoWay}" />
                    <NumberBox Header="遥测间隔（毫秒）" Maximum="5000" Minimum="50" Value="{x:Bind ViewModel.TelemetryIntervalMs, Mode=TwoWay}" />
                    <ToggleSwitch Header="启动时自动连接设备" IsOn="{x:Bind ViewModel.AutoConnect, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="应用行为" />
                    <ToggleSwitch Header="开机自启动" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                    <ToggleSwitch Header="最小化到托盘" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                    <ToggleSwitch Header="关闭到托盘" IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
                    <ToggleSwitch Header="自动检查更新" IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}" />
                    <ComboBox Header="界面语言" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="简体中文" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                    <ComboBox Header="温度单位" SelectedIndex="0">
                        <ComboBoxItem Content="摄氏度 ℃" />
                        <ComboBoxItem Content="华氏度 ℉" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.SaveCommand}" Content="保存设置" />
                <Button Command="{x:Bind ViewModel.CheckUpdatesCommand}" Content="检查更新" />
                <Button Command="{x:Bind ViewModel.OpenDataFolderCommand}" Content="打开数据目录" />
                <Button Click="PushOta_Click" Content="推送 OTA 包" />
            </StackPanel>

            <Border Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="主题迁移" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="从本机原 J-Center 安装目录导入内置主题、自定义媒体主题和 Theme\*.xml 布局主题。只写入本机应用数据，不会复制到项目仓库。" TextWrapping="Wrap" />
                    <Button Command="{x:Bind ViewModel.ImportJCenterThemesCommand}" Content="从原 J-Center 导入主题" />
                </StackPanel>
            </Border>
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <Border Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="关于" />
                    <TextBlock Text="J-Center-Lite 是一个独立实现的 WinUI 3 副屏控制工具。" TextWrapping="Wrap" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="不包含原厂商的二进制、驱动、字体、图片或固件；使用前请确认设备与 adb 的授权。" TextWrapping="Wrap" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="版本 1.0.0 · MIT License" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
