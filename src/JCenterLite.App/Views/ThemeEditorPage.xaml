<Page
    x:Class="JCenterLite.App.Views.ThemeEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:JCenterLite.App.Controls"
    xmlns:models="using:JCenterLite.Core.Models">
    <Grid Padding="24" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="主题" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.AddThemeCommand}" Content="新建主题" />
                <Button Command="{x:Bind ViewModel.DeleteThemeCommand}" Content="删除" />
            </StackPanel>
            <ListView ItemsSource="{x:Bind ViewModel.Themes}" SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ThemeDefinition">
                        <Grid Padding="4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:ThemeThumbnail Width="40" Height="40" VerticalAlignment="Center" Theme="{x:Bind}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Elements.Count}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="元素" />
            <ComboBox ItemsSource="{x:Bind ViewModel.ElementKinds}" SelectedItem="{x:Bind ViewModel.NewElementKind, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.AddElementCommand}" Content="添加元素" />
                <Button Command="{x:Bind ViewModel.DeleteElementCommand}" Content="删除元素" />
            </StackPanel>
            <ListView ItemsSource="{x:Bind ViewModel.SelectedTheme.Elements, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedElement, Mode=TwoWay}" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ThemeElementModel">
                        <TextBlock Padding="4" Text="{x:Bind Kind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="12" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="480 × 480 预览" />
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <controls:ThemeCanvas x:Name="Canvas" Theme="{x:Bind ViewModel.SelectedTheme, Mode=OneWay}" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.SaveCommand}" Content="保存主题库" />
                <Button Click="ApplyTheme_Click" Content="应用到副屏" />
                <Button Click="PickBackground_Click" Content="选择背景" />
            </StackPanel>
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="12">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="元素属性" />
            <TextBox Header="显示文本" Text="{x:Bind ViewModel.SelectedElement.Text, Mode=TwoWay}" />
            <TextBox Header="单位" Text="{x:Bind ViewModel.SelectedElement.Unit, Mode=TwoWay}" />
            <NumberBox Header="字号" Maximum="160" Minimum="8" Value="{x:Bind ViewModel.SelectedElement.FontSize, Mode=TwoWay}" />
            <NumberBox Header="缩放" Maximum="8" Minimum="0.2" SmallChange="0.1" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.SelectedElement.Scale, Mode=TwoWay}" />
            <NumberBox Header="旋转角度" Maximum="360" Minimum="0" Value="{x:Bind ViewModel.SelectedElement.Rotation, Mode=TwoWay}" />
            <ColorPicker x:Name="ElementColor" ColorChanged="ElementColor_ColorChanged" IsAlphaEnabled="True" />
            <Button Click="RefreshPreview_Click" Content="刷新预览" />
        </StackPanel>
    </Grid>
</Page>
