<Page
    x:Class="JCenterLite.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:JCenterLite.Core.Models">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="硬件监控" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="实时读取 CPU / GPU / 内存 / 硬盘 / 网络传感器，并推送到副屏。完整传感器通常需要以管理员身份运行。" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="Connect_Click" Content="连接设备" />
                <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="刷新传感器" />
                <Button Command="{x:Bind ViewModel.ToggleStreamingCommand}" Content="{x:Bind ViewModel.StreamingButtonText, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Shell.Status.Message, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Foreground="#FBBF24" Text="{x:Bind ViewModel.Shell.TakeoverHint, Mode=OneWay}" TextWrapping="Wrap" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                    <StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CPU 温度" /><TextBlock FontSize="28" Text="{x:Bind ViewModel.CpuTemperature, Mode=OneWay}" /></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                    <StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="GPU 温度" /><TextBlock FontSize="28" Text="{x:Bind ViewModel.GpuTemperature, Mode=OneWay}" /></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                    <StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CPU 占用" /><TextBlock FontSize="28" Text="{x:Bind ViewModel.CpuLoad, Mode=OneWay}" /></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                    <StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="GPU 占用" /><TextBlock FontSize="28" Text="{x:Bind ViewModel.GpuLoad, Mode=OneWay}" /></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                    <StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="风扇 / 水泵" /><TextBlock FontSize="20" Text="{x:Bind ViewModel.CpuFan, Mode=OneWay}" /></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                    <StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="内存" /><TextBlock FontSize="20" Text="{x:Bind ViewModel.Memory, Mode=OneWay}" /></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                    <StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="系统盘" /><TextBlock FontSize="20" Text="{x:Bind ViewModel.Storage, Mode=OneWay}" /></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="3" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                    <StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="网络" /><TextBlock FontSize="14" Text="{x:Bind ViewModel.Network, Mode=OneWay}" TextWrapping="Wrap" /></StackPanel>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="全部传感器" />
            <ListView ItemsSource="{x:Bind ViewModel.Readings}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SensorReading">
                        <Grid ColumnSpacing="12" Padding="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind DisplayValue}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
